{
  "expo": {
    "name": "VocBee",
    "slug": "vocbee",
    "scheme": [
      "vocbee",
      "com.vocbee.app",
      "com.googleusercontent.apps.540292978044-695plkaeec13scn3p2s76h302sieti4g"
    ],
    "version": "1.0.14",
    "icon": "./assets/icons/vocicon.png",
    "splash": {
      "image": "./assets/transparent-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vocbee.app",
      "appStoreUrl": "https://apps.apple.com/tr/app/vocbee-learn-vocabulary/id6760262917?l=tr",
      "buildNumber": "7",
      "googleServicesFile": "./GoogleService-Info.plist",
      "splash": {
        "image": "./assets/transparent-splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/transparent-splash.png",
          "backgroundColor": "#000000"
        }
      },
      "infoPlist": {
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you.",
        "NSCameraUsageDescription": "VocBee needs camera access to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "VocBee needs photo library access to choose a profile photo.",
        "ExpoLocalization_supportsRTL": true,
        "CFBundleLocalizations": [
          "en",
          "tr",
          "de",
          "fr",
          "es",
          "it",
          "pt",
          "ru",
          "ar",
          "zh",
          "ja",
          "ko",
          "hi",
          "id",
          "vi",
          "th",
          "am",
          "fa",
          "sr",
          "sw",
          "ur"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vocbee.app",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.vocbee.app&hl=tr",
      "versionCode": 5,
      "googleServicesFile": "./google-services.json",
      "splash": {
        "image": "./assets/transparent-splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/transparent-splash.png",
          "backgroundColor": "#000000"
        }
      },
      "permissions": ["android.permission.POST_NOTIFICATIONS"]
    },
    "notification": {
      "icon": "./assets/icons/notification-icon.png",
      "color": "#ffffff"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/transparent-splash.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/transparent-splash.png"
          },
          "ios": {
            "backgroundColor": "#ffffff",
            "image": "./assets/transparent-splash.png",
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#000000",
              "image": "./assets/transparent-splash.png"
            }
          },
          "android": {
            "backgroundColor": "#ffffff",
            "image": "./assets/transparent-splash.png",
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#000000",
              "image": "./assets/transparent-splash.png"
            }
          }
        }
      ],
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3149431742550187~5197491242",
          "iosAppId": "ca-app-pub-3149431742550187~9940490920",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VocBee needs photo library access to choose a profile photo.",
          "cameraPermission": "VocBee needs camera access to take a profile photo."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "tr",
              "de",
              "fr",
              "es",
              "it",
              "pt",
              "ru",
              "ar",
              "zh",
              "ja",
              "ko",
              "hi",
              "id",
              "vi",
              "th",
              "am",
              "fa",
              "sr",
              "sw",
              "ur"
            ],
            "android": [
              "en",
              "tr",
              "de",
              "fr",
              "es",
              "it",
              "pt",
              "ru",
              "ar",
              "zh",
              "ja",
              "ko",
              "hi",
              "id",
              "vi",
              "th",
              "am",
              "fa",
              "sr",
              "sw",
              "ur"
            ]
          }
        }
      ],
      "expo-apple-authentication",
      "expo-tracking-transparency",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "supportsRTL": true,
      "grammarProxyUrl": "https://vocbee-proxy.vercel.app/api/grammarProxy",
      "deleteAccountUrl": "https://vocbee-proxy.vercel.app/api/deleteAccount",
      "eas": {
        "projectId": "66067389-3a15-46ea-ade9-ed9a56f5d08b"
      }
    }
  }
}
