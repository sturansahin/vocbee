{
  "expo": {
    "name": "VocBee",
    "slug": "vocbee",
    "scheme": "vocbee",
    "version": "1.0.0",
    "icon": "./assets/icons/vocicon.png",
    "splash": {
      "image": "./assets/icons/vocicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vocbee.app"
    },
    "android": {
      "package": "com.vocbee.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/vocicon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3149431742550187~5197491242",
          "iosAppId": "ca-app-pub-3149431742550187~5197491242"
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "66067389-3a15-46ea-ade9-ed9a56f5d08b"
      }
    }
  }
}