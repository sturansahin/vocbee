{
  "expo": {
    "name": "VocBee",
    "slug": "vocbee",
    "scheme": "vocbee",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vocbee.app"
    },
    "android": {
      "package": "com.vocbee.app"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3149431742550187~5197491242",
          "iosAppId": "ca-app-pub-3149431742550187~5197491242"
        }
      ]
    ]
  }
}