{
  "name": "vocbee",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand",
    "test:ui": "jest --runInBand --coverage=false --testPathPattern=\"(presentation|shared/ui|shared/theme|shared/responsive|devtools)\" && node --test scripts/__tests__/uiAudit.test.cjs",
    "audit:ui": "node scripts/ui-audit.cjs",
    "coverage:check": "node scripts/check-feature-coverage.cjs",
    "test:boundaries": "jest --runInBand --coverage=false --runTestsByPath src/architecture/__tests__/importBoundaries.test.ts",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:rules": "tsc -p tsconfig.rules.json --noEmit",
    "typecheck:worker": "tsc proxy/grammar-worker.ts --noEmit --lib ES2022,WebWorker --skipLibCheck --moduleResolution bundler --module ESNext --target ES2022",
    "typecheck:all": "npm run typecheck && npm run typecheck:test && npm run typecheck:rules && npm run typecheck:worker",
    "test:rules": "firebase emulators:exec --project vocbee-rules-test --only firestore \"jest --config jest.rules.config.js --runInBand\"",
    "firestore:cleanup": "node scripts/firestoreLegacyCleanup.cjs",
    "firestore:cleanup:check": "node --check scripts/firestoreLegacyCleanup.cjs && node --check scripts/lib/firestoreLegacyCleanup.cjs",
    "test:firestore-cleanup": "node --test scripts/__tests__/firestoreLegacyCleanup.test.cjs",
    "test:firestore-cleanup:emulator": "firebase emulators:exec --project vocbee-firestore-cleanup-emulator --only firestore \"node --test scripts/__tests__/firestoreLegacyCleanup.emulator.test.cjs\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "functions:lint": "npm --prefix functions run lint",
    "functions:build": "npm --prefix functions run build",
    "api:check": "node --check api/deleteAccount.js && node --check api/grammarProxy.js",
    "unity:android:library": "node scripts/buildUnityAndroidLibrary.cjs",
    "unity:ios:framework": "node scripts/buildUnityIosFramework.cjs",
    "game:phase0:check": "node scripts/checkGamePhase0.cjs",
    "test:game-phase0": "node --test scripts/__tests__/gamePhase0.test.cjs",
    "game:vocabulary:generate": "node scripts/generateGameVocabulary.cjs",
    "game:vocabulary:check": "node scripts/generateGameVocabulary.cjs --check",
    "test:game-vocabulary": "node --test scripts/__tests__/generateGameVocabulary.test.cjs",
    "check:server-deps": "node scripts/check-server-dependency-boundary.cjs",
    "prettier:check": "prettier --check . --ignore-unknown --end-of-line auto",
    "format": "prettier --write . --ignore-unknown --end-of-line auto"
  },
  "dependencies": {
    "@expo-google-fonts/rubik-mono-one": "^0.4.1",
    "@expo-google-fonts/science-gothic": "^0.4.0",
    "@expo-google-fonts/special-elite": "^0.4.1",
    "@expo-google-fonts/special-gothic-expanded-one": "^0.4.0",
    "@expo/vector-icons": "^15.0.3",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.3.29",
    "expo": "^54.0.31",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.12",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.10",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.8",
    "expo-navigation-bar": "~5.0.10",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.16",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-tracking-transparency": "~6.0.8",
    "expo-updates": "~29.0.16",
    "firebase": "^12.7.0",
    "i18next": "^25.8.0",
    "lottie-react-native": "~7.3.1",
    "nativewind": "^2.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.5.4",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^16.0.1",
    "react-native-purchases": "^10.0.1",
    "react-native-purchases-ui": "^10.0.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@testing-library/react-native": "^13.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vercel/node": "^5.6.3",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-preset-expo": "~54.0.9",
    "eslint": "8.57.1",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "firebase-tools": "^15.16.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "prettier": "3.9.5",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.3.2",
    "ts-jest": "^29.1.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
