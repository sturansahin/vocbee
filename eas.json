        "EXPO_PUBLIC_GRAMMAR_PROXY_URL": "https://vocbee-proxy.vercel.app/api/grammarProxy",
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "appl_MZXWENkeyhjqCHRptMNhbzqgtsz"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GRAMMAR_PROXY_URL": "https://vocbee-proxy.vercel.app/api/grammarProxy",
