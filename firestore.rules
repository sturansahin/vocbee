rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function has(data, key) {
      return data.keys().hasAny([key]);
    }

    function optionalString(data, key, maxLength) {
      return !has(data, key)
        || data[key] == null
        || (data[key] is string && data[key].size() <= maxLength);
    }

    function optionalBoolean(data, key) {
      return !has(data, key) || data[key] is bool;
    }

    function optionalTimestamp(data, key) {
      return !has(data, key) || data[key] is timestamp;
    }

    function validLanguage(value) {
      return value in [
        'amharic', 'arabic', 'chinese', 'english', 'french', 'german',
        'hindi', 'indonesian', 'italian', 'japanese', 'korean', 'persian',
        'portuguese', 'russian', 'serbian', 'spanish', 'swahili', 'thai',
        'turkish', 'urdu', 'vietnamese'
      ];
    }

    function validUserLevel(value) {
      return value in ['beginner', 'intermediate', 'advanced'];
    }

    function validCefrLevel(value) {
      return value in ['A1', 'A2', 'B1', 'B2', 'C1'];
    }

    function validPreferences(value) {
      return value == null
        || (
          value is map
          && value.keys().hasOnly(['nativeLanguage', 'targetLanguage', 'level'])
          && validLanguage(value.nativeLanguage)
          && validLanguage(value.targetLanguage)
          && validUserLevel(value.level)
        );
    }

    function validProgress(value) {
      return value == null
        || (
          value is map
          && value.keys().hasOnly(['currentLevel', 'learnedWords', 'lastWordIndex', 'lastSync'])
          && validCefrLevel(value.currentLevel)
          && value.learnedWords is map
          && (!has(value, 'lastWordIndex') || (value.lastWordIndex is int && value.lastWordIndex >= 0))
          && (!has(value, 'lastSync') || value.lastSync is timestamp)
        );
    }

    function validStreak(value) {
      return value == null
        || (
          value is map
          && value.keys().hasOnly([
            'currentStreak',
            'longestStreak',
            'brokenStreak',
            'lastQualifiedDay',
            'lastQualifiedAt'
          ])
          && value.currentStreak is int
          && value.currentStreak >= 0
          && value.longestStreak is int
          && value.longestStreak >= 0
          && (
            !has(value, 'brokenStreak')
            || value.brokenStreak == null
            || (value.brokenStreak is int && value.brokenStreak >= 0)
          )
          && (
            !has(value, 'lastQualifiedDay')
            || value.lastQualifiedDay == null
            || value.lastQualifiedDay is string
          )
          && (
            !has(value, 'lastQualifiedAt')
            || value.lastQualifiedAt == null
            || value.lastQualifiedAt is string
          )
        );
    }

    function validNotificationSettings(value) {
      return value == null
        || (
          value is map
          && value.keys().hasOnly([
            'enabled',
            'startHour',
            'startMinute',
            'endHour',
            'endMinute',
            'frequencyMinutes',
            'autoMarkLearned'
          ])
          && value.enabled is bool
          && (
            (value.enabled == false && value.keys().hasOnly(['enabled']))
            || (
              value.autoMarkLearned is bool
              && value.startHour is int && value.startHour >= 0 && value.startHour <= 23
              && value.endHour is int && value.endHour >= 0 && value.endHour <= 23
              && value.startMinute is int && value.startMinute >= 0 && value.startMinute <= 59
              && value.endMinute is int && value.endMinute >= 0 && value.endMinute <= 59
              && value.frequencyMinutes in [60, 120, 180, 360, 1440]
            )
          )
        );
    }

    function validFavorites(value) {
      return value == null || (value is list && value.size() <= 1000);
    }

    function validSyncMeta(value) {
      return value == null
        || (
          value is map
          && value.keys().hasOnly(['version', 'updatedAt', 'updatedByDeviceId'])
          && (!has(value, 'version') || (value.version is int && value.version >= 1))
          && (!has(value, 'updatedAt') || value.updatedAt is timestamp)
          && optionalString(value, 'updatedByDeviceId', 120)
        );
    }

    function validProgressSummaryEntry(value) {
      return value is map
        && value.keys().hasOnly(['learnedCount', 'totalCount', 'percent'])
        && value.learnedCount is int
        && value.learnedCount >= 0
        && (
          !has(value, 'totalCount')
          || (value.totalCount is int && value.totalCount >= 0)
        )
        && (
          !has(value, 'percent')
          || (value.percent is number && value.percent >= 0 && value.percent <= 100)
        );
    }

    function validProgressSummary(value) {
      return value is map
        && value.keys().hasOnly(['byLevel', 'totalLearnedCount', 'overallPercent', 'updatedAt'])
        && value.byLevel is map
        && value.byLevel.keys().hasOnly(['A1', 'A2', 'B1', 'B2', 'C1'])
        && (!has(value.byLevel, 'A1') || validProgressSummaryEntry(value.byLevel.A1))
        && (!has(value.byLevel, 'A2') || validProgressSummaryEntry(value.byLevel.A2))
        && (!has(value.byLevel, 'B1') || validProgressSummaryEntry(value.byLevel.B1))
        && (!has(value.byLevel, 'B2') || validProgressSummaryEntry(value.byLevel.B2))
        && (!has(value.byLevel, 'C1') || validProgressSummaryEntry(value.byLevel.C1))
        && value.totalLearnedCount is int
        && value.totalLearnedCount >= 0
        && (
          !has(value, 'overallPercent')
          || (
            value.overallPercent is number
            && value.overallPercent >= 0
            && value.overallPercent <= 100
          )
        )
        && (!has(value, 'updatedAt') || value.updatedAt is timestamp);
    }

    function validProgressMigration(value) {
      return value is map
        && value.keys().hasOnly([
          'state',
          'source',
          'legacyMirrorEnabled',
          'migratedAt',
          'lastLegacyMirrorAt',
          'verifiedAt'
        ])
        && value.state in ['mirroring', 'verified', 'cleanup-ready']
        && value.source in ['legacy-mirror', 'backfill']
        && value.legacyMirrorEnabled is bool
        && value.migratedAt is timestamp
        && value.lastLegacyMirrorAt is timestamp
        && (!has(value, 'verifiedAt') || value.verifiedAt is timestamp);
    }

    function progressMigrationUnchanged() {
      return (
        !has(resource.data, 'progressMigration')
        && !has(request.resource.data, 'progressMigration')
      ) || (
        has(resource.data, 'progressMigration')
        && has(request.resource.data, 'progressMigration')
        && request.resource.data.progressMigration == resource.data.progressMigration
      );
    }

    function validUserDocument(data) {
      return data.keys().hasOnly([
        'email',
        'displayName',
        'photoURL',
        'createdAt',
        'setupCompleted',
        'preferences',
        'progress',
        'streak',
        'notificationSettings',
        'lastActiveDeviceId',
        'favorites',
        'syncMeta',
        'lastActiveAt',
        'schemaVersion',
        'activeLevel',
        'progressSummary',
        'progressMigration'
      ])
      && optionalString(data, 'email', 320)
      && optionalString(data, 'displayName', 120)
      && optionalString(data, 'photoURL', 2048)
      && optionalString(data, 'lastActiveDeviceId', 120)
      && optionalTimestamp(data, 'createdAt')
      && optionalTimestamp(data, 'lastActiveAt')
      && optionalBoolean(data, 'setupCompleted')
      && (!has(data, 'schemaVersion') || (data.schemaVersion is int && data.schemaVersion == 2))
      && (!has(data, 'activeLevel') || validCefrLevel(data.activeLevel))
      && (!has(data, 'preferences') || validPreferences(data.preferences))
      && (!has(data, 'progress') || validProgress(data.progress))
      && (!has(data, 'streak') || validStreak(data.streak))
      && (!has(data, 'notificationSettings') || validNotificationSettings(data.notificationSettings))
      && (!has(data, 'favorites') || validFavorites(data.favorites))
      && (!has(data, 'syncMeta') || validSyncMeta(data.syncMeta))
      && (!has(data, 'progressSummary') || validProgressSummary(data.progressSummary))
      && (!has(data, 'progressMigration') || validProgressMigration(data.progressMigration));
    }

    function validProgressByLevel(data, level) {
      return validCefrLevel(level)
        && data.keys().hasOnly([
          'level',
          'learnedWordIds',
          'favoriteWordIds',
          'wrongWordIds',
          'lastWordId',
          'learnedCount',
          'vocabularySchemaVersion',
          'updatedAt',
          'updatedByDeviceId',
          'version'
        ])
        && data.level == level
        && data.learnedWordIds is list
        && data.learnedWordIds.size() <= 5000
        && data.lastWordId is int
        && data.lastWordId >= 0
        && data.learnedCount is int
        && data.learnedCount == data.learnedWordIds.size()
        && data.vocabularySchemaVersion is int
        && data.vocabularySchemaVersion >= 1
        && data.updatedAt is timestamp
        && data.version is int
        && data.version == 2
        && (
          !has(data, 'favoriteWordIds')
          || (data.favoriteWordIds is list && data.favoriteWordIds.size() <= 1000)
        )
        && (
          !has(data, 'wrongWordIds')
          || (data.wrongWordIds is list && data.wrongWordIds.size() <= 1000)
        )
        && optionalString(data, 'updatedByDeviceId', 120);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !has(request.resource.data, 'progressMigration')
        && validUserDocument(request.resource.data);
      allow update: if isOwner(uid)
        && progressMigrationUnchanged()
        && validUserDocument(request.resource.data);
      allow delete: if isOwner(uid);

      match /progressByLevel/{level} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validProgressByLevel(request.resource.data, level);
        allow delete: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
