
# Grammar proxy URL (REQUIRED for production builds)
# Deploy proxy/grammar-worker.ts to Cloudflare Workers, then set:
EXPO_PUBLIC_GRAMMAR_PROXY_URL=https://your-grammar-proxy.your-subdomain.workers.dev

# RevenueCat public SDK keys
# Development/Test Store fallback:
EXPO_PUBLIC_REVENUECAT_API_KEY=test_SwKWiFPJFyWvvsHYtFKNTzSNZXw
# Production builds should prefer platform-specific app keys:
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_public_ios_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_public_android_key

# Groq API key - DEV ONLY fallback (never shipped in production builds)
# The proxy holds the real key server-side.
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here
